{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spacetrace",
  "version": "0.1.0",
  "identifier": "com.spacetrace.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "spacetrace",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "rpm", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "shortDescription": "See what is filling your disks",
    "longDescription": "spacetrace scans disks, keeps snapshots, and shows what grew — on this machine and on your servers.",
    "copyright": "Copyright © 2026",
    "category": "Utility"
  }
}
