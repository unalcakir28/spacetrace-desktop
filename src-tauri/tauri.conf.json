{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "spacetrace",
  "version": "0.1.0",
  "identifier": "com.spacetrace.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "spacetrace",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "deb",
      "rpm",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "See what is filling your disks",
    "longDescription": "spacetrace scans disks, keeps snapshots, and shows what grew \u2014 on this machine and on your servers.",
    "copyright": "Copyright \u00a9 2026",
    "category": "Utility",
    "publisher": "spacetrace",
    "homepage": "https://unalcakir28.github.io/spacetrace/",
    "linux": {
      "deb": {
        "section": "utils"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4MEMyQzgzNDBFOTU4RTcKUldUbldPbEFneXdNS0Z0QlFUWXg0T3craUU5T2N2NXZIWEhUMGVEcnlOU05NcVRIZTNoWnJDVUoK",
      "endpoints": [
        "https://github.com/unalcakir28/spacetrace/releases/download/desktop-latest/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
